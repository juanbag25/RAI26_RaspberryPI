# Copiá a mac_orchestrator/.env y ajustá si hace falta.

# URL del llm-server-RAI-026 (POST /v1/process).
LLM_API_URL=http://localhost:8000/v1/process
# Solo si el llm-server tiene SERVER_API_KEY configurado.
LLM_API_KEY=

# Host/puerto donde corre el cliente STT (linux/main.py) en esta misma Mac.
STT_HOST=127.0.0.1
CTRL_PORT=9001

# Puerto en el que este orquestador escucha los textos del STT.
ORCHESTRATOR_PORT=9000

# Voz de `say -v ?` para la respuesta hablada (ej. Mónica es_ES, Paulina es_MX).
TTS_VOICE=Mónica
