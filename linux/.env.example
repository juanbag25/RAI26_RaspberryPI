# Copiá este archivo a `.env` (gitignoreado) y completá tus valores.

# IP donde corre el orquestador (R-AI-026/orchestrator, escucha en :9000).
#   - Robot real: IP de la Jetson.
#   - Prueba en la PC (orquestador en el mismo WSL): 127.0.0.1
ORCHESTRATOR_IP=127.0.0.1

# API key de Groq para el STT (config.py BACKEND = "groq").
GROQ_API_KEY=

# Índice del micrófono para sounddevice (main.py lista los dispositivos al
# arrancar). Vacío = default del sistema; en WSLg eso es el mic default de
# Windows (RDPSource), así que normalmente no hace falta tocarlo.
AUDIO_INPUT_DEVICE=

# --- Tuning del mic (opcionales: vacío = default de config.py) ----------------
# Umbral de cercanía: cuánta energía tiene que tener una frase para que el robot
# la considere dirigida a él (default 0.055). Subilo si engancha charlas del
# fondo de la sala; bajalo si te ignora a vos. Calibrar con `python mic_level.py`.
NEAR_RMS_THRESHOLD=
# Cuántas veces por encima del ruido ambiente tiene que estar la voz (default 3).
NEAR_SNR_RATIO=
# Wake word: el robot ignora todo hasta que lo llaman (default true).
WAKE_WORD_ENABLED=
# Cómo se detecta el nombre (default audio):
#   audio = spotter local Vosk escuchando "oye rai" + beep; dormido no gasta Groq.
#           Necesita models/vosk-model-small-es-0.42 (ver README). Si falta,
#           cae solo a text.
#   text  = transcribe todo y busca "rai" en el texto (más lento, gasta Groq).
WAKE_MODE=
# Frases que despiertan en modo audio, separadas por coma (default
# "oye rai,oye ray,oye rey"). Tienen que sonar parecido, no exacto. Usá 2+
# palabras; agregá el prefijo que uses: oye rai,oye ray,oye rey,hola rai,hola ray
WAKE_PHRASES=
# Disparar con el parcial del reconocedor, ~300 ms antes (default true).
WAKE_ON_PARTIAL=
# Segundos tras un disparo en que se ignoran otros (default 1.5).
WAKE_COOLDOWN_S=
# Carpeta del modelo Vosk dentro de models/ (default vosk-model-small-es-0.42).
WAKE_MODEL_NAME=
# Sonido al despertar: beep (generado) | none | /ruta/a/ding.wav (default beep).
WAKE_SOUND=
# Volumen del sonido, 0..1 (default 0.4). Bajalo si el mic lo escucha fuerte.
WAKE_SOUND_VOLUME=
# Parlante para el beep: índice de sounddevice (mismo listado que el mic al
# arrancar). Vacío = salida default del sistema.
AUDIO_OUTPUT_DEVICE=
# Qué mandar al orquestador si la frase es SÓLO el nombre (modo text: "rai"
# para que conteste; modo audio: vacío, el beep ya confirma).
WAKE_ACK_TEXT=
# Segundos que sigue escuchando sin repetir el nombre, tras cada turno (25).
WAKE_WINDOW_S=
# Atención al que lo llamó: mientras está despierto, sólo acepta frases con al
# menos este porcentaje del nivel de voz del "rai" (default 0.6). Subilo (0.8)
# para que se cierre más sobre esa persona; 0 = desactivado.
ATTENTION_LEVEL_RATIO=
# 0 = hay que decir "rai" en CADA frase (modo estricto).
# En cuántas palabras iniciales se busca el nombre (default 3; 1 = tiene que
# ser la primera palabra).
WAKE_SEARCH_WORDS=
# Voz mínima para mandar a Whisper, en ms (default 400).
MIN_UTTERANCE_MS=
# Frames seguidos de voz fuerte para abrir una utterance (default 3; 30 ms c/u).
ONSET_SPEECH_FRAMES=
# Tope del piso de ruido medido (default 0.02). Subirlo endurece el filtro en
# salas ruidosas (umbral efectivo = max(NEAR_RMS_THRESHOLD, ruido*NEAR_SNR_RATIO)).
NOISE_FLOOR_MAX=

# --- Logs / diagnóstico (opcionales) -----------------------------------------
# Cada cuántos segundos imprimir la línea [HB] con el estado del mic/VAD/cola
# (default 10; 0 = nunca). Es lo primero a mirar si "escucha y no pasa nada".
LOG_HEARTBEAT_S=
# 1 = logs por frame ([DBG] voz floja no abre: ...). Muy verboso.
LOG_DEBUG=

# --- Alimentación (battery.py) -----------------------------------------------
# Cada cuántos segundos re-loguear tensión de entrada y flags de undervoltage
# de la Pi (default 300; 0 = sólo al arrancar).
POWER_LOG_S=

# --- dev_orchestrator.sh ------------------------------------------------------
# Nombre del servicio systemd que corre main.py en producción (default "stt").
# El script lo frena antes de apuntar el STT a tu PC y lo relevanta al salir.
STT_SERVICE=
