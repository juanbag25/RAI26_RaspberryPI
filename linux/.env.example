# Copiá este archivo a `.env` (gitignoreado) y completá tus valores.

# IP donde corre el orquestador (R-AI-026/orchestrator, escucha en :9000).
#   - Robot real: IP de la Jetson.
#   - Prueba en la PC (orquestador en el mismo WSL): 127.0.0.1
ORCHESTRATOR_IP=127.0.0.1

# API key de Groq para el STT (config.py BACKEND = "groq").
GROQ_API_KEY=

# Índice del micrófono para sounddevice (main.py lista los dispositivos al
# arrancar). Vacío = el ReSpeaker si está conectado, si no el default del
# sistema (en WSLg, el mic default de Windows).
AUDIO_INPUT_DEVICE=

# Qué mic: normal (default; USB común, mono) | array (ReSpeaker, foco por
# dirección). Los umbrales de nivel del array van con sufijo _ARRAY (abajo).
MIC_MODE=
# Modelo de Groq: whisper-large-v3 (default, más preciso) | whisper-large-v3-turbo
GROQ_MODEL=

# --- Mic array ReSpeaker (sólo MIC_MODE=array; ver README, "Mic array") ------
# Parámetros DSP extra, NOMBRE=valor separados por coma (`python respeaker.py`
# los lista). Ej: AGCMAXGAIN=10,HPFONOFF=3
RESPEAKER_PARAMS=
# Ángulo del chip que corresponde al frente del robot (calibrar con
# `python mic_level.py --doa` hablándole de frente). Default 0.
DOA_FORWARD_OFFSET_DEG=
# Sectores de ruido propio del robot (ventiladores, motores), marco del robot:
# "170-200,350-10". Frases de ahí se descartan siempre.
DOA_BLOCKED_SECTORS=
# Tolerancia del foco en grados (default 35) y fracción mínima de lecturas con
# voz dentro del foco para aceptar una frase (default 0.4).
DOA_TOLERANCE_DEG=
DOA_MIN_IN_FOCUS=

# --- Tuning del mic (opcionales: vacío = default de config.py) ----------------
# Detector de voz: silero (red neuronal, default; necesita models/silero_vad.onnx)
# | webrtc (el anterior). SILERO_THRESHOLD: probabilidad mínima de voz (0.5).
VAD_ENGINE=
SILERO_THRESHOLD=
# Umbral de cercanía: cuánta energía tiene que tener una frase para que el robot
# la considere dirigida a él (default 0.055). Subilo si engancha charlas del
# fondo de la sala; bajalo si te ignora a vos. Calibrar con `python mic_level.py`.
NEAR_RMS_THRESHOLD=
# Cuántas veces por encima del ruido ambiente tiene que estar la voz (default 3).
NEAR_SNR_RATIO=
# Lo mismo para MIC_MODE=array (escala ~10 dB más baja; defaults 0.025 / 0.025
# / 1.0 / 0.05). calibrate.py escribe los del modo activo.
RMS_THRESHOLD_ARRAY=
NEAR_RMS_THRESHOLD_ARRAY=
NEAR_SNR_RATIO_ARRAY=
NOISE_FLOOR_MAX_ARRAY=
# Wake word: el robot ignora todo hasta que lo llaman (default true).
WAKE_WORD_ENABLED=
# Cómo se detecta el nombre (default audio):
#   audio = spotter local Vosk escuchando "oye rai"; el robot contesta «Sí,
#           dime» (por el parlante de la Jetson); dormido no gasta Groq.
#           Necesita models/vosk-model-small-es-0.42 (ver README). Si falta,
#           cae solo a text.
#   text  = transcribe todo y busca "rai" en el texto (más lento, gasta Groq).
WAKE_MODE=
# Frases que despiertan en modo audio, separadas por coma (default
# "oye rai,oye ray,oye rey"). Tienen que sonar parecido, no exacto. Usá 2+
# palabras; agregá el prefijo que uses: oye rai,oye ray,oye rey,hola rai,hola ray
WAKE_PHRASES=
# Disparar con el parcial del reconocedor, ~300 ms antes (default true).
WAKE_ON_PARTIAL=
# Segundos tras un disparo en que se ignoran otros (default 1.5).
WAKE_COOLDOWN_S=
# Carpeta del modelo Vosk dentro de models/ (default vosk-model-small-es-0.42).
WAKE_MODEL_NAME=
# La Pi no emite sonido: el «Sí, dime» y los chimes los hace el orquestador.
# Qué mandar al orquestador como TURNO si la frase es SÓLO el nombre (default
# vacío: el «Sí, dime» del evento awake ya confirma).
WAKE_ACK_TEXT=
# Segundos que sigue escuchando sin repetir el nombre, contados desde que el
# robot termina de hablar (default 6: la orden va enseguida del «Sí, dime»).
WAKE_WINDOW_S=
# Tras mandar una orden, cuánto espera a que el robot conteste (default 12).
REPLY_WAIT_S=
# Atención por nivel SIN array (con el ReSpeaker manda la dirección): mientras
# está despierto, sólo acepta frases con al menos esta fracción del nivel de
# las frases anteriores de la conversación — NO del «oye rai», que se suele
# decir más fuerte (default 0.25; 0 = desactivado).
ATTENTION_LEVEL_RATIO=
# Lo mismo con el ReSpeaker (default 0: decide la dirección).
ATTENTION_LEVEL_RATIO_ARRAY=
# Mientras el robot habla: mute (default) | keyword (escucha órdenes de corte
# «para rai»/«basta rai»; experimental, ver README).
SPEAK_LISTEN_MODE=
# 0 = hay que decir "rai" en CADA frase (modo estricto).
# En cuántas palabras iniciales se busca el nombre (default 3; 1 = tiene que
# ser la primera palabra).
WAKE_SEARCH_WORDS=
# Voz mínima para mandar a Whisper, en ms (default 300).
MIN_UTTERANCE_MS=
# Frames seguidos de voz fuerte para abrir una utterance (default 3; 30 ms c/u).
ONSET_SPEECH_FRAMES=
# Tope del piso de ruido medido (default 0.05, alcanza el ruido del robot
# caminando). Subirlo endurece el filtro con ruido (umbral efectivo =
# max(NEAR_RMS_THRESHOLD, ruido*NEAR_SNR_RATIO)); si caminando te ignora, bajá
# NEAR_SNR_RATIO antes que esto.
NOISE_FLOOR_MAX=
# Ventana (ms) del estimador de ruido que corre siempre, aun con una frase
# abierta: percentil 10 del RMS de esa ventana (default 2000).
NOISE_WINDOW_MS=
# Un frame sigue la frase abierta sólo si llega a nivel_de_la_frase × esto
# (default 0.35). Subilo si el ruido estira las frases; bajalo si te corta.
CONTINUE_LEVEL_RATIO=
# Mismo criterio pero contra el umbral de apertura (default 1.0).
CLOSE_RMS_RATIO=
# Tope de duración de una frase en ms: se cierra igual (default 12000).
MAX_UTTERANCE_MS=
# Audio antes de que abra el VAD, en ms (default 350) y silencio final que se
# manda a Whisper (default 250; el resto se recorta: ahí alucina).
PRE_SPEECH_PADDING_MS=
TRAIL_SILENCE_KEEP_MS=
# Filtro de alucinaciones por segmento de Whisper (ver config.py).
STT_MAX_NO_SPEECH_PROB=
STT_MIN_LOGPROB=

# --- Logs / diagnóstico (opcionales) -----------------------------------------
# Cada cuántos segundos imprimir la línea [HB] con el estado del mic/VAD/cola
# (default 10; 0 = nunca). Es lo primero a mirar si "escucha y no pasa nada".
LOG_HEARTBEAT_S=
# 1 = logs por frame ([DBG] voz floja no abre: ...). Muy verboso.
LOG_DEBUG=

# --- Alimentación (battery.py) -----------------------------------------------
# Cada cuántos segundos re-loguear tensión de entrada y flags de undervoltage
# de la Pi (default 300; 0 = sólo al arrancar).
POWER_LOG_S=

# --- dev_orchestrator.sh ------------------------------------------------------
# Nombre del servicio systemd que corre main.py en producción (default "rai26-stt").
# El script lo frena antes de apuntar el STT a tu PC y lo relevanta al salir.
STT_SERVICE=
